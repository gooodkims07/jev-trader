# Monad RPC for sends, receipts, nonce and the one-time gas estimate.
# Public endpoint works for dry runs; use a dedicated provider (Alchemy/QuickNode) for live trading.
RPC_URL=https://rpc.monad.xyz
# RPC for book reads, eth_blockNumber polling and Trade logs. The public endpoint is the fastest of these
# (~18 ms per read) and this stays under its 25 rps cap: 1 read + 1 getLogs per block + polling every 150 ms.
READ_RPC_URL=https://rpc.monad.xyz
# Optional WebSocket for newHeads. Polling backstop runs regardless.
WS_URL=wss://rpc.monad.xyz

# Which exchange: kuru (default, Monad on-chain spot book, one order per block) or okx (USDT perpetual
# swap, one order per 300 ms tick). Kuru settings are ignored on OKX, and the OKX block at the end on Kuru.
VENUE=kuru

# Leave PRIVATE_KEY unset (or DRY_RUN=true) to simulate: real book, real decisions, orders rest for one
# block and fill when a real print crosses their price.
PRIVATE_KEY=
DRY_RUN=true

# mock | jev
MODEL=mock
TYPESAFE_AI_API_KEY=
JEV_MODEL_ID=jev-latest

# Every block posts one post-only limit order of this size on the side the model picked, this many ticks
# inside the touch (0 joins the best bid/ask). Sizes are in the coin traded (MON on Kuru). Kuru MON-USDC
# minimum order is 200 MON; tick is 0.000001. TRADE_SIZE_MON and MAX_POSITION_MON still work, as MON amounts.
TRADE_SIZE=200
QUOTE_INSIDE_TICKS=1
MAX_POSITION=1000
# Used for pnlPct, in the venue's quote currency (USDC on Kuru, USDT on OKX). BANKROLL_USD still works.
BANKROLL=100

# Kuru limit orders draw from the margin account, not the wallet. At startup the bot deposits enough to
# reach these balances. Asks need MON, bids need USDC. Proceeds of fills also land in margin.
MARGIN_MON=600
MARGIN_USDC=20
# MarginAccount for the MON-USDC market. Only change if MARKET changes.
MARGIN_ACCOUNT=0x2A68ba1833cDf93fa9Da1EEbd7F46242aD8E90c5

# Monad charges gas on the LIMIT, so the limit is hardcoded and eth_estimateGas never runs in the loop.
# Unset: estimated once at startup (needs margin funds), else 350000. Expect ~0.03 MON per block live.
GAS_LIMIT=
# EIP-1559 type-2 only. Effective price = base fee + priority, so a high cap costs nothing.
# Monad's base fee floor is 100 gwei and eth_maxPriorityFeePerGas is hardcoded at 2 gwei.
MAX_FEE_GWEI=400
PRIORITY_FEE_GWEI=2

PORT=3000

# OKX (VENUE=okx): a USDT perpetual swap. Live only with all three keys and DRY_RUN not true. Give the key
# read and trade permissions only, and register this server's IP. The account must be in net position mode.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# Contracts are converted from TRADE_SIZE / MAX_POSITION, which must be set in the swap's coin
# (XRP-USDT-SWAP: 100 XRP per contract, lots of 1 XRP; e.g. TRADE_SIZE=5, MAX_POSITION=25).
OKX_INST_ID=XRP-USDT-SWAP
# true: OKX demo trading (demo keys; it lists fewer swaps than the real market). false: real money.
OKX_DEMO=true
OKX_MARGIN_MODE=isolated
OKX_LEVERAGE=2
# Maker fee for simulated fills; live runs read the account's own tier.
OKX_MAKER_FEE_RATE=0.0002
# Loop step. 1000 = one decision and one order per second.
OKX_TICK_MS=300
# OKX asks Jev about the next HORIZON_BLOCKS (e.g. 5 = 5 s at 1 s ticks) and shows it LOOKBACK_BLOCKS of history
# (e.g. 30). LOOKBACK_BLOCKS defaults to HORIZON_BLOCKS.
LOOKBACK_BLOCKS=
# OKX: when Jev skips, still post the likelier side if its probability is at least this (e.g. 0.3). Empty = respect skips.
MIN_SIDE_PROB=
# Exchange-side emergency stop for the whole position, percent from the average entry (0 = off).
OKX_EMERGENCY_STOP_PCT=0

# Stops and take-profits, any venue (0 = off). Session: this run's P&L in the quote currency; close, then stop.
# Position: percent move from the average entry; close, then trade on. Closing uses reduce-only post-only orders.
RISK_SESSION_STOP_LOSS=0
RISK_SESSION_TAKE_PROFIT=0
RISK_POSITION_STOP_PCT=0
RISK_POSITION_TAKE_PCT=0
